---
import { defaultLang, ui } from "../../lang";
import HeroInkCanvas from "./HeroInkCanvas";
---

<section class="hero page-gutter-x bg-background">
  <div class="hero-canvas" aria-hidden="true">
    <HeroInkCanvas client:only="react" />
  </div>

  <div class="hero-copy">
    <h1 data-i18n="home.title" class="hero-title font-display">
      {ui[defaultLang]["home.title"]}
    </h1>
    <h2 data-i18n="home.subtitle" class="hero-subtitle font-sans">
      {ui[defaultLang]["home.subtitle"]}
    </h2>
  </div>

  <nav class="hero-cta font-display" aria-label="Sections">
    <a
      href="#work"
      data-i18n="home.cta.work"
      class="hero-cta-link text-accent"
    >
      {ui[defaultLang]["home.cta.work"]}
    </a>
    <span class="hero-cta-sep text-accent-500" aria-hidden="true">/</span>
    <a
      href="#about"
      data-i18n="home.cta.about"
      class="hero-cta-link text-accent-500"
    >
      {ui[defaultLang]["home.cta.about"]}
    </a>
  </nav>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 100svh;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: 6rem;
    text-align: center;
  }

  .hero-canvas {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-copy {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: white;
    mix-blend-mode: difference;
  }

  .hero-title {
    max-width: 22ch;
    text-wrap: balance;
    text-transform: uppercase;
    font-size: var(--text-xl);
  }

  .hero-subtitle {
    max-width: 40ch;
    text-wrap: balance;
    font-size: var(--text-xs);
  }

  @media (width >= 40rem) {
    .hero-title {
      max-width: 24ch;
      font-size: var(--text-2xl);
    }

    .hero-subtitle {
      max-width: 42ch;
    }
  }

  @media (width >= 48rem) {
    .hero-title {
      font-size: var(--text-3xl);
    }

    .hero-subtitle {
      max-width: 48ch;
      font-size: var(--text-lg);
    }
  }

  @media (width >= 64rem) {
    .hero-title {
      font-size: var(--text-4xl);
    }

    .hero-subtitle {
      max-width: 54ch;
    }
  }

  .hero-cta {
    position: relative;
    z-index: 10;
    margin-top: 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--text-2xl);
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  @media (width >= 40rem) {
    .hero-cta {
      gap: 1rem;
      font-size: var(--text-3xl);
    }
  }

  .hero-cta-sep {
    user-select: none;
  }

  .hero-cta-link {
    transition: opacity 150ms;
  }

  .hero-cta-link:hover {
    opacity: 0.7;
  }

  /* Effect consumed by the React island — justified :global. */
  :global(.hero-grain) {
    overflow: hidden;
    mix-blend-mode: lighten;
  }

  :global(.hero-grain)::before {
    content: "";
    position: absolute;
    top: -150%;
    left: -50%;
    width: 300%;
    height: 300%;
    background-image: url("/grain.svg");
    background-size: 160px;
    background-repeat: repeat;
    opacity: 0.45;
    animation: hero-grain 7s steps(10) infinite;
  }

  @keyframes hero-grain {
    0%,
    100% {
      transform: translate(0, 0);
    }
    10% {
      transform: translate(-8%, -12%);
    }
    20% {
      transform: translate(14%, 4%);
    }
    30% {
      transform: translate(-4%, 18%);
    }
    40% {
      transform: translate(10%, -16%);
    }
    50% {
      transform: translate(-18%, 6%);
    }
    60% {
      transform: translate(6%, 14%);
    }
    70% {
      transform: translate(-12%, -8%);
    }
    80% {
      transform: translate(16%, 10%);
    }
    90% {
      transform: translate(-6%, -14%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.hero-grain)::before {
      animation: none;
    }
  }
</style>
