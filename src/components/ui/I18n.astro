---
import { defaultLang, languages, langStorageKey, ui } from '../../lang'

const entries = Object.entries(languages)
---

<div
  role="group"
  data-lang-switcher
  data-i18n-aria-label="language.label"
  aria-label="Language"
  class="fixed bottom-5 right-5 z-50 flex items-baseline gap-2 mix-blend-difference sm:bottom-8 sm:right-8"
>
  {
    entries.map(([lang, label], index) => (
      <span class="contents">
        {index > 0 && (
          <span class="select-none text-xs text-white/40" aria-hidden="true">
            /
          </span>
        )}
        <button
          type="button"
          data-lang={lang}
          class="cursor-pointer font-sans text-xs uppercase tracking-[0.14em] text-white opacity-45 transition-opacity hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/60 aria-[current=true]:opacity-100"
        >
          {label}
        </button>
      </span>
    ))
  }
</div>

<script is:inline define:vars={{ ui, defaultLang, langStorageKey }}>
  const supported = Object.keys(ui)

  function detectLang() {
    const stored = localStorage.getItem(langStorageKey)
    if (stored && supported.includes(stored)) return stored

    const browser = (navigator.language || '').slice(0, 2).toLowerCase()
    if (supported.includes(browser)) return browser

    return defaultLang
  }

  function t(lang, key) {
    return ui[lang]?.[key] || ui[defaultLang][key] || key
  }

  function applyLang(lang) {
    document.documentElement.lang = lang

    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n')
      if (key) el.textContent = t(lang, key)
    })

    document.querySelectorAll('[data-i18n-aria-label]').forEach((el) => {
      const key = el.getAttribute('data-i18n-aria-label')
      if (key) el.setAttribute('aria-label', t(lang, key))
    })

    document.querySelectorAll('[data-lang]').forEach((el) => {
      if (el.getAttribute('data-lang') === lang) {
        el.setAttribute('aria-current', 'true')
      } else {
        el.removeAttribute('aria-current')
      }
    })
  }

  const lang = detectLang()
  localStorage.setItem(langStorageKey, lang)
  applyLang(lang)

  document.addEventListener('click', (event) => {
    const target = event.target
    const el = target instanceof Element ? target : target.parentElement
    const button = el?.closest('[data-lang-switcher] [data-lang]')
    const next = button?.getAttribute('data-lang')
    if (!next || !supported.includes(next)) return

    localStorage.setItem(langStorageKey, next)
    applyLang(next)
  })
</script>
