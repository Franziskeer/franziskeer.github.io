---
import Icon from "./Icon.astro";

type Props = {
  tech: string;
};

const { tech } = Astro.props;
---

<span class="inline-flex items-center gap-1 rounded-full border text-neutral-900 border-neutral-900 bg-neutral-100 px-2 py-1 text-xs leading-none tracking-wide font-display">
  <Icon name={tech} class="size-5" />
  <span><slot /></span>
</span>
