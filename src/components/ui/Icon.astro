---
import { iconifyIcon } from "../../content/skillIcons";

type Props = {
  name: string;
  class?: string;
};

const { name, class: className } = Astro.props;
const icon = iconifyIcon(name);
---

{
  icon && (
    <svg class={className} viewBox={icon.viewBox} aria-hidden="true" set:html={icon.body} />
  )
}
