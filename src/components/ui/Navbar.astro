---
import { Menu, Xmark } from "iconoir-react";
import { defaultLang, ui } from "../../lang";
---

<header class="nav-header">
  <nav class="nav-bar page-gutter-x" aria-label="Primary">
    <a
      href="/"
      class="nav-logo"
      aria-label={ui[defaultLang]["site.title"]}
    >
      <img
        src="/favicon.svg"
        alt=""
        width="72"
        height="72"
        class="nav-logo-img"
        decoding="async"
      />
    </a>

    <!-- Reserva el hueco del toggle (el botón real es fixed + mix-blend). -->
    <span class="nav-toggle-spacer" aria-hidden="true"></span>
  </nav>
</header>

<button
  type="button"
  data-nav-toggle
  class="nav-toggle"
  aria-expanded="false"
  aria-controls="nav-menu"
  data-i18n-aria-label="nav.menu"
  aria-label={ui[defaultLang]["nav.menu"]}
>
  <span data-nav-icon="open" class="nav-toggle-icon">
    <Menu width={32} height={32} strokeWidth={1.6} aria-hidden />
  </span>
  <span data-nav-icon="close" class="nav-toggle-icon nav-toggle-icon--close" aria-hidden="true">
    <Xmark width={32} height={32} strokeWidth={1.6} aria-hidden />
  </span>
</button>

<div
  id="nav-menu"
  data-nav-menu
  class="nav-menu"
  aria-hidden="true"
>
  <ul class="nav-menu-list page-gutter-x font-display">
    <li class="nav-menu-item">
      <a
        href="#work"
        data-nav-link
        data-i18n="home.cta.work"
        class="nav-menu-link"
      >
        {ui[defaultLang]["home.cta.work"]}
      </a>
    </li>
    <li class="nav-menu-item">
      <a
        href="#about"
        data-nav-link
        data-i18n="home.cta.about"
        class="nav-menu-link"
      >
        {ui[defaultLang]["home.cta.about"]}
      </a>
    </li>
  </ul>
</div>

<style>
  .nav-header {
    pointer-events: none;
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
  }

  .nav-bar {
    pointer-events: auto;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
  }

  @media (width >= 40rem) {
    .nav-bar {
      padding-block: 1.25rem;
    }
  }

  .nav-logo {
    display: inline-flex;
    flex-shrink: 0;
  }

  .nav-logo:focus-visible {
    outline: none;
  }

  .nav-logo-img {
    height: 3.5rem;
    width: 3.5rem;
    transform-origin: left center;
    transition: transform 300ms ease-out;
  }

  .nav-logo:hover .nav-logo-img {
    transform: scale(1.05);
  }

  @media (width >= 40rem) {
    .nav-logo-img {
      height: 4rem;
      width: 4rem;
    }
  }

  @media (width >= 48rem) {
    .nav-logo-img {
      height: 4.5rem;
      width: 4.5rem;
    }
  }

  .nav-toggle-spacer {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
  }

  .nav-toggle {
    pointer-events: auto;
    position: fixed;
    top: 1rem;
    right: var(--spacing-page-gutter-x);
    z-index: 50;
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    padding: 0;
    color: white;
    mix-blend-mode: difference;
    transition: opacity 300ms;
  }

  .nav-toggle:hover {
    opacity: 0.7;
  }

  .nav-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.5);
  }

  @media (width >= 40rem) {
    .nav-toggle {
      top: 1.25rem;
      right: var(--spacing-page-gutter-x-sm);
    }
  }

  .nav-toggle-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 300ms,
      scale 300ms;
  }

  .nav-toggle-icon--close {
    opacity: 0;
    scale: 0.75;
  }

  .nav-menu {
    pointer-events: none;
    visibility: hidden;
    position: fixed;
    inset: 0;
    z-index: 40;
    min-height: 100svh;
    background-color: color-mix(in oklab, var(--color-background) 95%, transparent);
    opacity: 0;
    transition:
      opacity 400ms,
      visibility 400ms;
  }

  .nav-menu-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 7rem;
    font-size: var(--text-3xl);
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  @media (width >= 40rem) {
    .nav-menu-list {
      gap: 1.5rem;
      padding-top: 8rem;
      font-size: var(--text-4xl);
    }
  }

  .nav-menu-item {
    opacity: 0;
    transform: translateY(1rem);
  }

  .nav-menu-link {
    display: inline-block;
    transition: color 300ms;
  }

  .nav-menu-link:hover,
  .nav-menu-link:focus-visible {
    color: var(--color-accent);
    outline: none;
  }

  [data-nav-menu][data-open] {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
  }

  [data-nav-menu][data-open] .nav-menu-item {
    animation: nav-link-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  [data-nav-menu][data-open] .nav-menu-item:nth-child(1) {
    animation-delay: 80ms;
  }

  [data-nav-menu][data-open] .nav-menu-item:nth-child(2) {
    animation-delay: 160ms;
  }

  [data-nav-toggle][aria-expanded="true"] {
    color: var(--color-text);
    mix-blend-mode: normal;
  }

  [data-nav-toggle][aria-expanded="true"] [data-nav-icon="open"] {
    opacity: 0;
    scale: 0.75;
  }

  [data-nav-toggle][aria-expanded="true"] [data-nav-icon="close"] {
    opacity: 1;
    scale: 1;
  }

  @keyframes nav-link-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-logo-img,
    .nav-toggle,
    .nav-toggle-icon,
    .nav-menu,
    .nav-menu-link {
      transition: none !important;
    }

    [data-nav-menu][data-open] .nav-menu-item {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const menu = document.querySelector("[data-nav-menu]");

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.toggleAttribute("data-open", open);
      menu.setAttribute("aria-hidden", String(!open));
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    menu.querySelectorAll("[data-nav-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
