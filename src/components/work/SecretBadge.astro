---
import { defaultLang, ui } from "../../lang";

const t = ui[defaultLang];
const label = t["work.case.secret"];
---

<!-- Same pill footprint as Badge.astro, but it is a link and the glitch lives in CSS. -->
<a class="secret-badge" href="/secret">
  <!-- 10×10 pixel tile. crispEdges keeps each rect as a hard pixel, no anti-alias. -->
  <span class="secret-badge__icon" aria-hidden="true">
    <svg viewBox="0 0 10 10" shape-rendering="crispEdges">
      <rect width="10" height="10" fill="#111"></rect>
      <rect width="3" height="10" fill="#ececec"></rect>
      <rect x="3" width="2" height="4" fill="#3ad6f0"></rect>
      <rect x="3" y="4" width="2" height="3" fill="#e83a9a"></rect>
      <rect x="3" y="7" width="2" height="3" fill="#f0c800"></rect>
      <rect x="5" width="5" height="2" fill="#1a1a1a"></rect>
      <rect x="5" y="2" width="4" height="3" fill="#ececec"></rect>
      <rect x="9" y="2" width="1" height="3" fill="#3ad6f0"></rect>
      <rect x="5" y="5" width="5" height="1" fill="#e83a9a"></rect>
      <rect x="5" y="6" width="3" height="4" fill="#3ad6f0"></rect>
      <rect x="8" y="6" width="2" height="4" fill="#ececec"></rect>
    </svg>
  </span>
  <!-- Three copies of the same word, stacked. The coloured ones are decorative. -->
  <span class="secret-badge__label">
    <span class="secret-badge__layer" data-i18n="work.case.secret">{label}</span>
    <span class="secret-badge__layer secret-badge__layer--red" aria-hidden="true" data-i18n="work.case.secret">{label}</span>
    <span class="secret-badge__layer secret-badge__layer--cyan" aria-hidden="true" data-i18n="work.case.secret">{label}</span>
  </span>
</a>

<style>
  .secret-badge {
    --secret-red: #ff2bd6;
    --secret-cyan: #00e5ff;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    /* Clip scanlines and RGB overflow to the pill. */
    overflow: hidden;
    border: 1px solid var(--color-primary);
    border-radius: 9999px;
    background: #f5f5f5;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-decoration: none;
    /* Own stacking context so multiply/overlay stay inside the badge. */
    isolation: isolate;
    /* Chromatic aberration on the border, no extra markup. */
    box-shadow:
      1px 0 0 var(--secret-cyan),
      -1px 0 0 var(--secret-red);
    /* steps(1) = jump, never interpolate. Idle most of the time, then a 1–2% spike. */
    animation: secret-frame 4.8s steps(1) infinite;
  }

  /* Same loops, shorter duration = feels more unstable on interaction. */
  .secret-badge:hover,
  .secret-badge:focus-visible {
    animation-duration: 1.15s;
  }

  .secret-badge:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .secret-badge::before,
  .secret-badge::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  /* CRT scanlines: 1px gap, 1px dark line, tiled over the whole pill. */
  .secret-badge::before {
    inset: 0;
    z-index: 2;
    background: repeating-linear-gradient(
      to bottom,
      rgb(0 0 0 / 0) 0 1px,
      rgb(0 0 0 / 0.14) 1px 2px
    );
    opacity: 0.55;
    mix-blend-mode: multiply;
  }

  /* Horizontal sweep that travels top → bottom. */
  .secret-badge::after {
    left: 0;
    right: 0;
    height: 2px;
    z-index: 3;
    background: rgb(255 255 255 / 0.7);
    mix-blend-mode: overlay;
    animation: secret-scan 2.6s linear infinite;
  }

  .secret-badge__icon {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    overflow: hidden;
  }

  .secret-badge__icon svg {
    width: 100%;
    height: 100%;
    animation: secret-icon 3.4s steps(1) infinite;
  }

  .secret-badge:hover .secret-badge__icon svg,
  .secret-badge:focus-visible .secret-badge__icon svg {
    animation-duration: 0.7s;
  }

  /* Stack the three text copies in one cell so they share width. */
  .secret-badge__label {
    position: relative;
    display: grid;
  }

  .secret-badge__layer {
    grid-area: 1 / 1;
  }

  /* Magenta + cyan on multiply = RGB fringe where they drift off the black layer. */
  .secret-badge__layer--red,
  .secret-badge__layer--cyan {
    pointer-events: none;
    user-select: none;
    mix-blend-mode: multiply;
  }

  /* Different durations so the two channels desync. */
  .secret-badge__layer--red {
    color: var(--secret-red);
    animation: secret-slice-red 3.7s steps(1) infinite;
  }

  .secret-badge__layer--cyan {
    color: var(--secret-cyan);
    animation: secret-slice-cyan 4.4s steps(1) infinite;
  }

  .secret-badge:hover .secret-badge__layer--red,
  .secret-badge:focus-visible .secret-badge__layer--red {
    animation-duration: 0.85s;
  }

  .secret-badge:hover .secret-badge__layer--cyan,
  .secret-badge:focus-visible .secret-badge__layer--cyan {
    animation-duration: 0.95s;
  }

  /* Whole-badge jitter. Long rest keyframes, then a one-frame shove. */
  @keyframes secret-frame {
    0%,
    18%,
    24%,
    61%,
    70%,
    100% {
      transform: none;
      filter: none;
    }
    19% {
      transform: translate(-2px, 1px);
      filter: contrast(1.35) saturate(1.4);
    }
    20% {
      transform: translate(3px, -1px);
    }
    62% {
      transform: translate(2px, 0);
      filter: hue-rotate(-18deg);
    }
    63% {
      transform: translate(-1px, 1px);
    }
  }

  @keyframes secret-scan {
    0% {
      top: -20%;
    }
    100% {
      top: 120%;
    }
  }

  /* Sprite: hue hit + a vertical squash so it looks like a torn scanline. */
  @keyframes secret-icon {
    0%,
    72%,
    84%,
    100% {
      transform: none;
      filter: none;
    }
    73% {
      transform: translateX(2px);
      filter: hue-rotate(80deg);
    }
    74% {
      transform: translateX(-3px) scaleY(1.15);
      filter: hue-rotate(-50deg);
    }
    85% {
      transform: translate(1px, 1px);
      filter: contrast(1.6);
    }
  }

  /*
    Slice glitch: clip-path: inset(top right bottom left) keeps one horizontal band,
    then translate shoves that band. Most of the cycle is fully visible (inset 0).
  */
  @keyframes secret-slice-red {
    0%,
    11%,
    17%,
    48%,
    56%,
    100% {
      transform: translate(0, 0);
      clip-path: inset(0 0 0 0);
    }
    13% {
      transform: translate(3px, -1px);
      clip-path: inset(10% 0 58% 0);
    }
    14% {
      transform: translate(-4px, 1px);
      clip-path: inset(62% 0 8% 0);
    }
    49% {
      transform: translate(4px, 0);
      clip-path: inset(38% 0 28% 0);
    }
  }

  @keyframes secret-slice-cyan {
    0%,
    28%,
    36%,
    77%,
    86%,
    100% {
      transform: translate(0, 0);
      clip-path: inset(0 0 0 0);
    }
    29% {
      transform: translate(-3px, 1px);
      clip-path: inset(55% 0 12% 0);
    }
    30% {
      transform: translate(2px, -2px);
      clip-path: inset(6% 0 64% 0);
    }
    78% {
      transform: translate(-4px, 0);
      clip-path: inset(22% 0 46% 0);
    }
  }

  /* Keep a static RGB offset so it still reads as glitched without motion. */
  @media (prefers-reduced-motion: reduce) {
    .secret-badge,
    .secret-badge::after,
    .secret-badge__icon svg,
    .secret-badge__layer--red,
    .secret-badge__layer--cyan {
      animation: none;
    }

    .secret-badge__layer--red {
      transform: translate(-1px, 0);
    }

    .secret-badge__layer--cyan {
      transform: translate(1px, 0);
    }
  }
</style>
