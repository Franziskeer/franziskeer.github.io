---
import { SKILL_EXPERTISE_MAX, skillsByGroup } from "../../content/skills";
import { defaultLang, i18nMap, ui } from "../../lang";
import Header from "../ui/Header.astro";
import Icon from "../ui/Icon.astro";

const groups = skillsByGroup();
const lang = defaultLang;
const t = ui[lang];

function expertiseLabel(name: string, expertise: number) {
  return {
    en: `${name}, ${expertise} of ${SKILL_EXPERTISE_MAX}`,
    es: `${name}, ${expertise} de ${SKILL_EXPERTISE_MAX}`,
  };
}
---

<section>
  <Header id="skills-title" data-i18n="work.skills.title">
    {t["work.skills.title"]}
  </Header>

  <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">
    {groups.map((group) => (
      <div>
        <h3 class="text-xs font-semibold uppercase text-accent" data-i18n-map={i18nMap(group.label)}>
          {group.label[lang]}
        </h3>

        <ul class="list-none">
          {group.skills.map((skill) => {
            const level = Math.min(SKILL_EXPERTISE_MAX, Math.max(0, skill.expertise));
            const label = expertiseLabel(skill.name, level);
            return (
              <li class="flex items-center justify-between gap-4 border-b last:border-b-0 border-black/20 py-2">
                <span class="inline-flex items-center gap-2 text-sm">
                  <Icon name={skill.id} class="size-3.5 shrink-0" />
                  <span class="truncate">{skill.name}</span>
                </span>
                <div
                  class="flex shrink-0 gap-[0.28rem]"
                  role="img"
                  aria-label={label[lang]}
                  data-i18n-map={i18nMap(label)}
                  data-i18n-map-attr="aria-label"
                >
                  {Array.from({ length: SKILL_EXPERTISE_MAX }, (_, tick) => (
                    <span
                      class:list={[
                        "inline-block size-[0.55rem] border border-accent",
                        tick < level ? "bg-accent" : "bg-transparent",
                      ]}
                    ></span>
                  ))}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</section>
