---
import type { LocalizedString } from "../../lang";
import { defaultLang, i18nMap } from "../../lang";

type Props = {
  image?: string;
  imageAlt?: LocalizedString;
  class?: string;
  eager?: boolean;
};

const { image, imageAlt, eager = false, class: className } = Astro.props;
const lang = defaultLang;
---

<div class:list={["aspect-21/9 size-full overflow-hidden rounded-xl", className]}>
  {
    image && (
      <img
        class="size-full rounded-xl transition-transform duration-500 ease-out group-hover:scale-[1.07] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        src={image}
        alt={imageAlt?.[lang] ?? ""}
        data-i18n-map-attr={imageAlt ? "alt" : undefined}
        data-i18n-map={imageAlt ? i18nMap(imageAlt) : undefined}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    )
  }
  <!-- <span class="grain-shift pointer-events-none absolute inset-0" aria-hidden="true"></span> -->
</div>
