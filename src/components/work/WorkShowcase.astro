---
import { defaultLang, ui } from "../../lang";
import { experience, projects } from "../../content/work";
import WorkContact from "./WorkContact.astro";
import WorkExperience from "./WorkExperience.astro";
import WorkProjectItem from "./WorkProjectItem.astro";
import WorkSkills from "./WorkSkills.astro";

const t = ui[defaultLang];
---

<div>
  <section aria-labelledby="work-title">
    <header>
      <h1
        id="work-title"
        class="m-0 font-display text-5xl/normal xl:text-9xl/normal uppercase text-grain"
        data-i18n="work.title"
      >
        {t["work.title"]}
      </h1>
    </header>

    <ol class="m-0 grid list-none p-0">
      {projects.map((project, index) => <WorkProjectItem {...project} index={index} />)}
    </ol>
  </section>

  <WorkExperience items={experience} />
  <WorkSkills />
  <WorkContact />
</div>
