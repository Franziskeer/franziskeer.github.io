---
import { projects } from "../../content/work";
import { defaultLang, ui } from "../../lang";
import "../../styles/projects-carousel.css";
import Header from "../ui/Header.astro";
import WorkProjectItem from "./WorkProjectItem.astro";

const t = ui[defaultLang];
---

<section class="min-w-0">
  <Header data-i18n="work.projects.title">
    {t["work.projects.title"]}
  </Header>

  <ol class="projects-carousel m-0 list-none p-0">
    {projects.map((project, index) => <WorkProjectItem {...project} index={index} />)}
  </ol>
</section>
