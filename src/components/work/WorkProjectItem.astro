---
import { projectPath, type WorkProject } from "../../content/work";
import { defaultLang, i18nMap } from "../../lang";
import Badge from "../ui/Badge.astro";
import WorkMedia from "./WorkMedia.astro";

type Props = WorkProject & {
  index: number;
};

const { id, title, year, category, stack, summary, image, imageAlt, index } = Astro.props;

const number = String(index + 1).padStart(2, "0");
const flip = index % 2 === 1;
const lang = defaultLang;
---

<li class="border-b work-rule" id={id}>
  <a
    class="work-item group grid gap-6 py-6 text-inherit no-underline outline-offset-4 focus-visible:outline-2 focus-visible:outline-accent xl:grid-cols-2 xl:gap-32 xl:py-0"
    href={projectPath(id)}
  >
    <div class="relative flex min-h-48 flex-col justify-center py-6 pr-12">
      <p class="mb-1.5 text-sm leading-none text-accent">{number}</p>
      <h2 class="work-item-title m-0 font-display text-xl uppercase" data-i18n-map={i18nMap(title)}>
        {title[lang]}
      </h2>
      <p class="mt-3 max-w-[42ch] text-sm text-secondary" data-i18n-map={i18nMap(summary)}>
        {summary[lang]}
      </p>
      <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-xs opacity-65">
        <span>{year}</span>
        <span data-i18n-map={i18nMap(category)}>{category[lang]}</span>
      </p>
      {stack.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1">
          {stack.map((tech) => <Badge>{tech}</Badge>)}
        </div>
      )}
      <span class="work-item-arrow" aria-hidden="true">↗</span>
    </div>

    <WorkMedia
      class:list={["min-h-56 xl:min-h-[22rem]", flip && "xl:order-first"]}
      number={number}
      image={image}
      imageAlt={imageAlt}
    />
  </a>
</li>

<style>
  .work-item-title {
    transition: transform 250ms ease;
  }

  .group:hover .work-item-title,
  .group:focus-visible .work-item-title {
    transform: translateX(0.35rem);
  }

  .work-item-arrow {
    position: absolute;
    right: 0;
    bottom: 1.5rem;
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    color: var(--color-accent);
    transition:
      transform 250ms ease,
      background-color 250ms ease,
      color 250ms ease;
  }

  .group:hover .work-item-arrow,
  .group:focus-visible .work-item-arrow {
    transform: rotate(45deg);
    background-color: var(--color-accent);
    color: var(--color-background);
  }

  .group:hover :global(.work-media-image),
  .group:focus-visible :global(.work-media-image) {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-item-title,
    .work-item-arrow {
      transition: none;
    }

    .group:hover .work-item-title,
    .group:focus-visible .work-item-title,
    .group:hover .work-item-arrow,
    .group:focus-visible .work-item-arrow,
    .group:hover :global(.work-media-image),
    .group:focus-visible :global(.work-media-image) {
      transform: none;
    }
  }
</style>
