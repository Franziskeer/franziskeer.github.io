---
import { projectPath, type WorkProject } from "../../content/work";
import { defaultLang, i18nMap, ui } from "../../lang";
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";
import WorkMedia from "./WorkMedia.astro";

type Props = WorkProject & {
  index: number;
};

const { id, title, stack, summary, image, imageAlt, index } = Astro.props;

const flip = index % 2 === 1;
const lang = defaultLang;
---

<li id={id} class="border-b border-black/20 last:border-b-0">
  <a class="group py-8 grid xl:grid-cols-10 gap-4 xl:gap-8" href={projectPath(id)}>
    <WorkMedia image={image} imageAlt={imageAlt} class="xl:col-span-4" class:list={[flip && "xl:order-last"]} />

    <div class="flex flex-col gap-4 xl:col-span-6">
      <h2 class="font-display text-xl xl:text-3xl transition-colors duration-300 group-hover:text-accent" data-i18n-map={i18nMap(title)}>
        {title[lang]}
      </h2>
      <p class="relative text-sm text-secondary" data-i18n-map={i18nMap(summary)}>
        {summary[lang]}
      </p>
      {
        stack.length > 0 && (
          <div class="flex flex-wrap gap-1">
            {stack.map((tech) => (
              <Badge tech={tech}>{tech}</Badge>
            ))}
          </div>
        )
      }
      <span class="mt-auto inline-flex items-center gap-1 text-xs uppercase text-accent">
        <span data-i18n="work.projects.cta">
          {ui[defaultLang]["work.projects.cta"]}
        </span>
        <Icon name="iconoir:arrow-up-right" class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </span>
    </div>
  </a>
</li>
