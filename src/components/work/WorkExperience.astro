---
import type { WorkExperience } from "../../content/work";
import { defaultLang, i18nMap, ui } from "../../lang";
import Badge from "../ui/Badge.astro";
import Header from "../ui/Header.astro";

type Props = {
  items: readonly WorkExperience[];
};

const { items } = Astro.props;
const lang = defaultLang;
const t = ui[lang];
---

<section>
  <Header id="experience-title" data-i18n="work.experience.title">
    {t["work.experience.title"]}
  </Header>

  <ol class="m-0 grid list-none p-0">
    {items.map((item) => (
      <li class="grid gap-2 xl:grid-cols-[auto_1fr] border-b last:border-b-0 border-black/20 py-6 first:pt-0 last:pb-0" id={item.id}>
        <p class="xl:px-4 py-2 text-xs text-accent">{item.years}</p>
        <div class="space-y-2">
          <h3 class="font-display text-lg uppercase" data-i18n-map={i18nMap(item.company)}>
            {item.company[lang]}
          </h3>
          <h4 class="text-accent text-xs uppercase" data-i18n-map={i18nMap(item.role)}>
            {item.role[lang]}
          </h4>
          <p class="text-sm text-secondary" data-i18n-map={i18nMap(item.summary)}>
            {item.summary[lang]}
          </p>
          {item.points && item.points.length > 0 && (
            <ul class="text-sm text-secondary list-disc list-outside pl-4">
              {item.points.map((point) => (
                <li class="py-1" data-i18n-map={i18nMap(point)}>{point[lang]}</li>
              ))}
            </ul>
          )}
          {item.stack.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {item.stack.map((tech) => <Badge tech={tech}>{tech}</Badge>)}
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>
