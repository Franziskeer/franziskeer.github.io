---
/**
 * Sala CRT: HUD + prueba activa. HTML/CSS, sin canvas ni blend modes
 * (el overlay/screen a pantalla completa pintaba una banda diagonal).
 */
---

<div class="crt" data-crt data-uv>
  <p class="crt-hud crt-hud-level" data-level>01</p>
  <p class="crt-hud crt-hud-error">ERROR_03:<br />SAVE FILE CORRUPTED</p>
  <p class="crt-hud crt-hud-player">PLAYER_01</p>

  <div class="crt-stage">
    <div class="pin" data-pin-slots hidden>
      <span class="pin-slot"></span>
      <span class="pin-slot"></span>
      <span class="pin-slot"></span>
      <span class="pin-slot"></span>
    </div>
    <div class="keypad" data-keypad role="grid" aria-label="Corrupted keypad"></div>
  </div>

  <div class="uv-cursor" data-uv-cursor aria-hidden="true">
    <span class="uv-cursor__lamp" data-uv-lamp></span>
    <span class="uv-cursor__core"></span>
    <span class="uv-cursor__core uv-cursor__core--red"></span>
    <span class="uv-cursor__core uv-cursor__core--cyan"></span>
  </div>

  <div class="crt-scanlines" aria-hidden="true"></div>
  <div class="crt-sweep" aria-hidden="true"></div>
</div>

<script>
  import { mountKeypad } from "./keypadTrial";
  import { nextRiddleStage, readRiddleStage, writeRiddleStage } from "./riddleProgress";

  const crt = document.querySelector("[data-crt]");
  const keypad = document.querySelector("[data-keypad]");
  const pinSlots = document.querySelector("[data-pin-slots]");
  const uvCursor = document.querySelector("[data-uv-cursor]");
  const level = document.querySelector("[data-level]");

  if (
    crt instanceof HTMLElement &&
    keypad instanceof HTMLElement &&
    pinSlots instanceof HTMLElement &&
    uvCursor instanceof HTMLElement &&
    level instanceof HTMLElement
  ) {
    const show = (stage: ReturnType<typeof readRiddleStage>) => {
      level.textContent = stage.padStart(2, "0");
      keypad.hidden = false;
      keypad.toggleAttribute("data-solved", stage !== "1");
      pinSlots.hidden = stage === "1";
      keypad.setAttribute("aria-label", stage === "1" ? "Corrupted keypad" : "PIN pad");
    };

    let lastX = 0;
    let lastY = 0;
    let dragging = false;
    let dragged = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let swallowClick = false;
    const TAP = 12;

    const paintUv = (x = lastX, y = lastY) => {
      keypad.querySelectorAll("[data-print]").forEach((cell) => {
        if (!(cell instanceof HTMLElement)) return;
        const box = cell.getBoundingClientRect();
        cell.style.setProperty("--uv-x", `${x - box.left}px`);
        cell.style.setProperty("--uv-y", `${y - box.top}px`);
      });
    };

    const place = (clientX: number, clientY: number) => {
      const box = crt.getBoundingClientRect();
      const x = Math.min(box.width, Math.max(0, clientX - box.left));
      const y = Math.min(box.height, Math.max(0, clientY - box.top));
      uvCursor.style.transform = `translate(${x}px, ${y}px)`;
      lastX = box.left + x;
      lastY = box.top + y;
      if (keypad.hasAttribute("data-pin")) paintUv(lastX, lastY);
    };

    const park = () => {
      const stage = crt.getBoundingClientRect();
      place(stage.left + 30, stage.bottom - 30);
    };

    window.addEventListener("pointermove", (event) => {
      if (event.pointerType === "mouse") place(event.clientX, event.clientY);
    });

    crt.addEventListener(
      "pointerdown",
      (event) => {
        if (event.pointerType === "mouse") return;
        event.preventDefault();
        dragging = true;
        dragged = false;
        dragStartX = event.clientX;
        dragStartY = event.clientY;
        crt.setPointerCapture(event.pointerId);
        place(event.clientX, event.clientY);
      },
      true,
    );

    crt.addEventListener("pointermove", (event) => {
      if (!dragging || event.pointerType === "mouse") return;
      if (Math.hypot(event.clientX - dragStartX, event.clientY - dragStartY) > TAP) {
        dragged = true;
      }
      place(event.clientX, event.clientY);
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging || event.pointerType === "mouse") return;
      dragging = false;
      if (crt.hasPointerCapture(event.pointerId)) {
        crt.releasePointerCapture(event.pointerId);
      }
      if (dragged) return;
      const hit = document.elementFromPoint(event.clientX, event.clientY);
      const key = hit instanceof Element ? hit.closest("button.keypad-cell") : null;
      if (!(key instanceof HTMLButtonElement) || key.disabled) return;
      key.click();
      swallowClick = true;
    };

    crt.addEventListener("pointerup", endDrag);
    crt.addEventListener("pointercancel", endDrag);

    crt.addEventListener(
      "click",
      (event) => {
        if (!swallowClick) return;
        swallowClick = false;
        event.preventDefault();
        event.stopImmediatePropagation();
      },
      true,
    );

    let stopKeypad: (() => void) | undefined;

    const start = () => {
      const stage = readRiddleStage();
      stopKeypad?.();
      stopKeypad = undefined;
      show(stage);
      stopKeypad = mountKeypad(
        keypad,
        () => {
          const next = nextRiddleStage("1");
          if (!next) return;
          writeRiddleStage(next);
          show(next);
          paintUv();
        },
        { settled: stage !== "1", pinSlots },
      );
      park();
    };

    start();
  }
</script>

<style>
  .uv-cursor {
    pointer-events: none;
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    opacity: 1;
  }

  .uv-cursor__lamp {
    pointer-events: none;
    position: absolute;
    left: 0;
    top: 0;
    width: var(--uv-size);
    height: var(--uv-size);
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle calc(var(--uv-size) / 2) at 50% 50%,
      rgb(176 90 255 / 0.42) 0%,
      rgb(120 40 220 / 0.14) 38%,
      transparent 70%
    );
  }

  .uv-cursor__core {
    pointer-events: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 11px;
    height: 11px;
    translate: -50% -50%;
    background: #f5f5f5;
    border: 1px solid #040404;
    box-shadow:
      1px 0 0 #00e5ff,
      -1px 0 0 #ff2bd6;
    animation: secret-frame 1.05s steps(1) infinite;
  }

  .uv-cursor__core--red,
  .uv-cursor__core--cyan {
    pointer-events: none;
  }

  .uv-cursor__core--red {
    background: #ff2bd6;
    mix-blend-mode: multiply;
    animation: secret-slice-red 0.8s steps(1) infinite;
  }

  .uv-cursor__core--cyan {
    background: #00e5ff;
    mix-blend-mode: multiply;
    animation: secret-slice-cyan 0.95s steps(1) infinite;
  }

  .crt {
    --uv-size: 5.5rem;
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #050505;
    color: #ececec;
    font-family: ui-monospace, "Cascadia Code", "SF Mono", monospace;
    touch-action: none;
  }

  .crt-hud {
    position: absolute;
    z-index: 2;
    margin: 0;
    font-size: clamp(0.7rem, 1.6vw, 0.85rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: pre-line;
  }

  .crt-hud-level {
    top: 1.25rem;
    left: 1.25rem;
  }

  .crt-hud-player {
    right: 1.25rem;
    bottom: 1.25rem;
  }

  .crt-hud-error {
    top: 1.25rem;
    right: 1.25rem;
    color: #6e1212;
    text-align: right;
    animation: crt-error 2.8s steps(2, end) infinite;
  }

  .crt-stage {
    place-self: center;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1.35rem;
  }

  .crt-scanlines,
  .crt-sweep {
    pointer-events: none;
    position: absolute;
  }

  .crt-scanlines {
    inset: 0;
    z-index: 3;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      rgb(255 255 255 / 0.04) 2px 3px
    );
  }

  .crt-sweep {
    left: 0;
    right: 0;
    height: 2px;
    z-index: 4;
    background: rgb(255 255 255 / 0.22);
    animation: crt-scan 2.6s linear infinite;
  }

  .pin {
    display: flex;
    gap: 0.85rem;
  }

  .pin[hidden] {
    display: none;
  }

  .pin-slot {
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid #ececec;
    border-radius: 50%;
    background: transparent;
  }

  .pin-slot[data-filled] {
    background: #ececec;
  }

  .pin[data-no] .pin-slot {
    border-color: #6e1212;
  }

  .pin[data-no] .pin-slot[data-filled] {
    background: #6e1212;
  }

  .pin[data-ok] .pin-slot {
    border-color: #00e5ff;
    background: #00e5ff;
  }

  .keypad {
    display: grid;
    grid-template-columns: repeat(3, 4.5rem);
    grid-template-rows: repeat(3, 4.5rem);
    gap: 0.45rem;
  }

  .keypad :global(.keypad-cell) {
    --secret-red: #ff2bd6;
    --secret-cyan: #00e5ff;
    --cell-frame: 4.8s;
    --cell-red: 3.7s;
    --cell-cyan: 4.4s;
    --cell-delay: 0s;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--color-primary, #040404);
    background: #f5f5f5;
    padding: 0;
    font-family: var(--font-display), ui-monospace, monospace;
    font-size: 1.35rem;
    line-height: 1;
    letter-spacing: 0.04em;
    color: #040404;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    box-shadow:
      1px 0 0 var(--secret-cyan),
      -1px 0 0 var(--secret-red);
    animation: secret-frame var(--cell-frame) steps(1) infinite;
    animation-delay: var(--cell-delay);
  }

  .keypad :global(.keypad-cell:hover:not([data-placed])),
  .keypad :global(.keypad-cell:focus-visible:not([data-placed])) {
    outline: none;
    animation-duration: 1.15s;
  }

  .keypad :global(.keypad-cell[data-selected]) {
    outline: none;
    background: #e7f9ff;
    box-shadow: inset 0 0 0 3px #00e5ff;
  }

  .keypad :global(.keypad-cell__label) {
    position: relative;
    z-index: 2;
    display: grid;
  }

  .keypad :global(.keypad-cell[data-print]) {
    --uv-x: -999px;
    --uv-y: -999px;
  }

  .keypad :global(.keypad-cell__uv) {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    --uv-mask: radial-gradient(
      circle calc(var(--uv-size) / 2) at var(--uv-x) var(--uv-y),
      #000 0%,
      #000 38%,
      transparent 70%
    );
    -webkit-mask-image: var(--uv-mask);
    mask-image: var(--uv-mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .keypad :global(.keypad-cell__print) {
    position: absolute;
    inset: 0;
  }

  .keypad :global(.keypad-cell__print img) {
    display: block;
    box-sizing: border-box;
    position: absolute;
    left: var(--print-x, 0%);
    top: var(--print-y, 0%);
    width: var(--print-size, 78%);
    height: var(--print-size, 78%);
    object-fit: contain;
    transform: rotate(var(--print-rot, 0deg));
    filter: invert(16%) sepia(90%) saturate(3200%) hue-rotate(258deg) brightness(90%);
  }

  .keypad :global(.keypad-cell__marks) {
    position: absolute;
    top: 0.32rem;
    left: 0.32rem;
    display: grid;
    grid-template-columns: repeat(2, 0.32rem);
    gap: 0.14rem;
  }

  .keypad :global(.keypad-cell__mark) {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: #040404;
  }

  .keypad[data-pin] :global(.keypad-cell__uv) {
    opacity: 1;
  }

  .keypad :global(.keypad-cell__layer) {
    grid-area: 1 / 1;
  }

  .keypad :global(.keypad-cell__layer--red),
  .keypad :global(.keypad-cell__layer--cyan) {
    pointer-events: none;
    user-select: none;
    mix-blend-mode: multiply;
  }

  .keypad :global(.keypad-cell__layer--red) {
    color: var(--secret-red);
    animation: secret-slice-red var(--cell-red) steps(1) infinite;
    animation-delay: var(--cell-delay);
  }

  .keypad :global(.keypad-cell__layer--cyan) {
    color: var(--secret-cyan);
    animation: secret-slice-cyan var(--cell-cyan) steps(1) infinite;
    animation-delay: var(--cell-delay);
  }

  .keypad :global(.keypad-cell:hover:not([data-placed]) .keypad-cell__layer--red),
  .keypad :global(.keypad-cell:focus-visible:not([data-placed]) .keypad-cell__layer--red),
  .keypad :global(.keypad-cell[data-selected] .keypad-cell__layer--red) {
    animation-duration: 0.85s;
  }

  .keypad :global(.keypad-cell:hover:not([data-placed]) .keypad-cell__layer--cyan),
  .keypad :global(.keypad-cell:focus-visible:not([data-placed]) .keypad-cell__layer--cyan),
  .keypad :global(.keypad-cell[data-selected] .keypad-cell__layer--cyan) {
    animation-duration: 0.95s;
  }

  @keyframes crt-scan {
    0% {
      top: -20%;
    }
    100% {
      top: 120%;
    }
  }

  @keyframes secret-frame {
    0%,
    18%,
    24%,
    61%,
    70%,
    100% {
      transform: none;
      filter: none;
    }
    19% {
      transform: translate(-2px, 1px);
      filter: contrast(1.35) saturate(1.4);
    }
    20% {
      transform: translate(3px, -1px);
    }
    62% {
      transform: translate(2px, 0);
      filter: hue-rotate(-18deg);
    }
    63% {
      transform: translate(-1px, 1px);
    }
  }

  @keyframes secret-slice-red {
    0%,
    11%,
    17%,
    48%,
    56%,
    100% {
      transform: translate(0, 0);
      clip-path: inset(0 0 0 0);
    }
    13% {
      transform: translate(3px, -1px);
      clip-path: inset(10% 0 58% 0);
    }
    14% {
      transform: translate(-4px, 1px);
      clip-path: inset(62% 0 8% 0);
    }
    49% {
      transform: translate(4px, 0);
      clip-path: inset(38% 0 28% 0);
    }
  }

  @keyframes secret-slice-cyan {
    0%,
    28%,
    36%,
    77%,
    86%,
    100% {
      transform: translate(0, 0);
      clip-path: inset(0 0 0 0);
    }
    29% {
      transform: translate(-3px, 1px);
      clip-path: inset(55% 0 12% 0);
    }
    30% {
      transform: translate(2px, -2px);
      clip-path: inset(6% 0 64% 0);
    }
    78% {
      transform: translate(-4px, 0);
      clip-path: inset(22% 0 46% 0);
    }
  }

  @keyframes crt-error {
    0%,
    86%,
    100% {
      transform: translate(0);
      text-shadow: none;
      opacity: 1;
    }
    88% {
      transform: translate(2px, -1px);
      text-shadow: -2px 0 #4a0000;
      opacity: 0.75;
    }
    92% {
      transform: translate(-2px, 1px);
      text-shadow: 2px 0 #2a0000;
      opacity: 1;
    }
  }

  @media (width >= 40rem) {
    .keypad {
      grid-template-columns: repeat(3, 5.5rem);
      grid-template-rows: repeat(3, 5.5rem);
      gap: 0.6rem;
    }

    .keypad :global(.keypad-cell) {
      font-size: 1.6rem;
    }
  }

  .keypad :global(.keypad-cell[data-placed]),
  .keypad :global(.keypad-cell[data-placed] .keypad-cell__layer--red),
  .keypad :global(.keypad-cell[data-placed] .keypad-cell__layer--cyan),
  .keypad[data-solved] :global(.keypad-cell),
  .keypad[data-solved] :global(.keypad-cell__layer--red),
  .keypad[data-solved] :global(.keypad-cell__layer--cyan) {
    animation: none;
  }

  .keypad :global(.keypad-cell[data-placed]),
  .keypad[data-solved] :global(.keypad-cell) {
    box-shadow: none;
  }

  .keypad :global(.keypad-cell[data-placed] .keypad-cell__layer--red),
  .keypad :global(.keypad-cell[data-placed] .keypad-cell__layer--cyan),
  .keypad[data-solved] :global(.keypad-cell__layer--red),
  .keypad[data-solved] :global(.keypad-cell__layer--cyan) {
    display: none;
  }

  .keypad[data-pin] :global(.keypad-cell[data-press]) {
    transform: scale(0.94);
    filter: brightness(0.92);
  }

  .keypad[data-pin]:not([data-ok]) :global(.keypad-cell:hover),
  .keypad[data-pin]:not([data-ok]) :global(.keypad-cell:focus-visible) {
    outline: none;
  }

  .keypad[data-no] {
    animation: pin-shake 0.45s ease;
  }

  .keypad[data-no] :global(.keypad-cell) {
    box-shadow: 0 0 0 1px #6e1212;
  }

  .keypad[data-ok] :global(.keypad-cell) {
    box-shadow: 0 0 0 1px #00e5ff;
  }

  @keyframes pin-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-7px);
    }
    50% {
      transform: translateX(7px);
    }
    75% {
      transform: translateX(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crt-sweep,
    .crt-hud-error,
    .keypad :global(.keypad-cell),
    .keypad :global(.keypad-cell__layer--red),
    .keypad :global(.keypad-cell__layer--cyan),
    .uv-cursor__core,
    .uv-cursor__core--red,
    .uv-cursor__core--cyan,
    .keypad[data-no] {
      animation: none;
    }

    .keypad :global(.keypad-cell__layer--red) {
      transform: translate(-1px, 0);
    }

    .keypad :global(.keypad-cell__layer--cyan) {
      transform: translate(1px, 0);
    }
  }
</style>
